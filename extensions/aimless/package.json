{
  "name": "@aimless/browser-toolkit",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "A collection of practical browser tools for developers.",
  "scripts": {
    "dev": "wxt",
    "dev:test": "vite",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "verify:artifacts": "node ../../build/verify-extension-artifacts.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@aimless/ui": "workspace:*",
    "@lib-stack/logger": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/chrome": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "catalog:",
    "typescript": "catalog:",
    "wxt": "catalog:"
  }
}
